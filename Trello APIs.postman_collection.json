    {
      "name": "Validate Key and Token In Jira",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.trello.com/1/members/me?key=b0d8e030665181b410c2ef6d5709aeab&token=ATTA2d51857ff8bd15b5bbf6e2bbcc9cdc153b19b62a00ab18b93c1fabfda806a7845D65BB63",
          "protocol": "https",
          "host": [
            "api",
            "trello",
            "com"
          ],
          "path": [
            "1",
            "members",
            "me"
          ],
          "query": [
            {
              "key": "key",
              "value": "b0d8e030665181b410c2ef6d5709aeab"
            },
            {
              "key": "token",
              "value": "ATTA2d51857ff8bd15b5bbf6e2bbcc9cdc153b19b62a00ab18b93c1fabfda806a7845D65BB63"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();\r\npm.collectionVariables.set(\"board_id\", response.id);\r\n\r\npm.test(\"Successful POST request\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});\r\n\r\npm.test(\"Board ID is present\", function () {\r\n    pm.expect(response.id).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\npm.test(\"Board name is correct\", function () {\r\n    pm.expect(response.name).to.eql(\"Board_Dele\");\r\n});\r\n\r\npm.test(\"Board is open\", function () {\r\n    pm.expect(response.closed).to.eql(false);\r\n});\r\n\r\npm.test(\"Board URLs are present\", function () {\r\n    pm.expect(response.url).to.include(\"trello.com/b/\");\r\n    pm.expect(response.shortUrl).to.include(\"trello.com/b/\");\r\n});\r\n\r\npm.test(\"Board visibility is private\", function () {\r\n    pm.expect(response.prefs.permissionLevel).to.eql(\"private\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "https://api.trello.com/1/boards/?name=Board_Dele&key={{key}}&token={{token}}",
          "protocol": "https",
          "host": [
            "api",
            "trello",
            "com"
          ],
          "path": [
            "1",
            "boards",
            ""
          ],
          "query": [
            {
              "key": "name",
              "value": "Board_Dele"
            },
            {
              "key": "key",
              "value": "{{key}}"
            },
            {
              "key": "token",
              "value": "{{token}}"
            }
          ]
        },
        "description": "Generated from cURL: curl --request POST \\\r\n  --url 'https://api.trello.com/1/boards/?name={name}' \\\r\n  --header 'Authorization: Bearer <access_token>'"
      },
      "response": []
    },
    {
      "name": "Get Board After Creation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.test(\"Board deleted successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Board ID is correct\", function () {\r\n    pm.expect(response.id).to.eql(pm.collectionVariables.get(\"board_id\"));\r\n});\r\n\r\npm.test(\"Board name is correct\", function () {\r\n    pm.expect(response.name).to.eql(\"Board_Dele\");\r\n});\r\n\r\npm.test(\"Board is open\", function () {\r\n    pm.expect(response.closed).to.eql(false);\r\n});\r\n\r\npm.test(\"Board URLs are present\", function () {\r\n    pm.expect(response.url).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(response.shortUrl).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\npm.test(\"Board visibility is private\", function () {\r\n    pm.expect(response.prefs.permissionLevel).to.eql(\"private\");\r\n});\r\n\r\npm.test(\"Board background is blue\", function () {\r\n    pm.expect(response.prefs.background).to.eql(\"blue\");\r\n});\r\n\r\npm.test(\"Organization ID is correct\", function () {\r\n    pm.expect(response.idOrganization)\r\n        .to.eql(\"6a6cfa9e7e95b4fb7f61c8cc\");\r\n});"
            ]
          }
        }
      ],
